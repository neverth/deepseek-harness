{
  "name": "@deepseek-ai/dsh-tool-agent-groups",
  "description": "Model-facing group_members tool: reports the hand-made sidebar group a Session belongs to and its peer Sessions",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
